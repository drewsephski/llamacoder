40:["$","div",null,{"className":"divide-y divide-border border-y border-border","children":[["$","section","Bolt does not rely on platform lock-in",{"id":"bolt-does-not-rely-on-platform-lock-in","className":"scroll-mt-28 py-12 sm:py-14","children":["$","div",null,{"className":"grid gap-5 md:grid-cols-[4rem_minmax(0,1fr)] md:gap-8","children":[["$","span",null,{"className":"font-mono text-sm text-primary","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"className":"text-balance text-2xl font-semibold tracking-[-0.025em] sm:text-3xl","children":"Bolt does not rely on platform lock-in"}],["$","p",null,{"className":"mt-4 text-[1.05rem] leading-8 text-muted-foreground","children":"Bolt supports project download, GitHub integration, and publishing outside Bolt. Its documentation explicitly positions GitHub as a path for working beyond the browser builder. Squid's differentiation is therefore not basic access to files; it is the consistency and verification metadata wrapped around a React export."}],"$undefined"]}]]}]}],["$","section","Tokens and credits answer different questions",{"id":"tokens-and-credits-answer-different-questions","className":"scroll-mt-28 py-12 sm:py-14","children":["$","div",null,{"className":"grid gap-5 md:grid-cols-[4rem_minmax(0,1fr)] md:gap-8","children":[["$","span",null,{"className":"font-mono text-sm text-primary","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"className":"text-balance text-2xl font-semibold tracking-[-0.025em] sm:text-3xl","children":"Tokens and credits answer different questions"}],["$","p",null,{"className":"mt-4 text-[1.05rem] leading-8 text-muted-foreground","children":"Bolt usage is token-based. Its documentation explains that tokens are used when the system reads, thinks, builds, and processes project context, and that larger projects may use more with each message. Squid maps selected models to an expected credit hold and later records actual cost and any returned credits. Buyers should compare predictability and observability rather than treating tokens and credits as directly equivalent."}],"$undefined"]}]]}]}],["$","section","Recovery is a strength in both products",{"id":"recovery-is-a-strength-in-both-products","className":"scroll-mt-28 py-12 sm:py-14","children":["$","div",null,{"className":"grid gap-5 md:grid-cols-[4rem_minmax(0,1fr)] md:gap-8","children":[["$","span",null,{"className":"font-mono text-sm text-primary","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"className":"text-balance text-2xl font-semibold tracking-[-0.025em] sm:text-3xl","children":"Recovery is a strength in both products"}],["$","p",null,{"className":"mt-4 text-[1.05rem] leading-8 text-muted-foreground","children":"Bolt's visual Version History can browse, preview, label, bookmark, and restore saved versions. Squid keeps code-bearing assistant responses as checkpoints and turns a restore into a new checkpoint. The latter makes the recovery event part of the visible project timeline."}],"$undefined"]}]]}]}],["$","section","Export verification is Squid's sharpest distinction",{"id":"export-verification-is-squid-s-sharpest-distinction","className":"scroll-mt-28 py-12 sm:py-14","children":["$","div",null,{"className":"grid gap-5 md:grid-cols-[4rem_minmax(0,1fr)] md:gap-8","children":[["$","span",null,{"className":"font-mono text-sm text-primary","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"className":"text-balance text-2xl font-semibold tracking-[-0.025em] sm:text-3xl","children":"Export verification is Squid's sharpest distinction"}],["$","p",null,{"className":"mt-4 text-[1.05rem] leading-8 text-muted-foreground","children":"Squid validates internal import paths, flags accessible-name issues, checks protected paths, assembles missing run support, and verifies the final archive. The export includes machine-readable reports so a developer can see what passed and what still needs review."}],"$L4d"]}]]}]}],"$L4e"]}]
