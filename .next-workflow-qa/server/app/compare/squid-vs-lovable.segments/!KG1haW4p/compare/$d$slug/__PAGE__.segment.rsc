34:["$","section","Credit visibility is not a one-number comparison",{"id":"credit-visibility-is-not-a-one-number-comparison","className":"scroll-mt-28 py-12 sm:py-14","children":["$","div",null,{"className":"grid gap-5 md:grid-cols-[4rem_minmax(0,1fr)] md:gap-8","children":[["$","span",null,{"className":"font-mono text-sm text-primary","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"className":"text-balance text-2xl font-semibold tracking-[-0.025em] sm:text-3xl","children":"Credit visibility is not a one-number comparison"}],["$","p",null,{"className":"mt-4 text-[1.05rem] leading-8 text-muted-foreground","children":"Lovable separates workspace credits used while building from usage-based balances for its cloud hosting and in-app AI. Squid's current builder shows the selected model's expected credit requirement before generation, reserves that amount, then records the estimate, actual charge, and refund after a successful result. Buyers should compare the whole cost path, not only monthly plan labels."}],"$undefined"]}]]}]}]
35:["$","section","Both products have recovery; the semantics differ",{"id":"both-products-have-recovery-the-semantics-differ","className":"scroll-mt-28 py-12 sm:py-14","children":["$","div",null,{"className":"grid gap-5 md:grid-cols-[4rem_minmax(0,1fr)] md:gap-8","children":[["$","span",null,{"className":"font-mono text-sm text-primary","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"className":"text-balance text-2xl font-semibold tracking-[-0.025em] sm:text-3xl","children":"Both products have recovery; the semantics differ"}],["$","p",null,{"className":"mt-4 text-[1.05rem] leading-8 text-muted-foreground","children":"Lovable lets users inspect history, preview older states, and revert. Squid stores assistant results as code checkpoints and restores an old version by creating a new assistant checkpoint. That preserves the path back to both the old and current states instead of silently replacing the latest record."}],"$undefined"]}]]}]}]
36:["$","section","Where Lovable is the stronger fit",{"id":"where-lovable-is-the-stronger-fit","className":"scroll-mt-28 py-12 sm:py-14","children":["$","div",null,{"className":"grid gap-5 md:grid-cols-[4rem_minmax(0,1fr)] md:gap-8","children":[["$","span",null,{"className":"font-mono text-sm text-primary","children":"05"}],["$","div",null,{"children":[["$","h2",null,{"className":"text-balance text-2xl font-semibold tracking-[-0.025em] sm:text-3xl","children":"Where Lovable is the stronger fit"}],["$","p",null,{"className":"mt-4 text-[1.05rem] leading-8 text-muted-foreground","children":"Lovable is compelling when a team wants an integrated full-stack environment with managed cloud, authentication, database, payments, publishing, and collaboration. Squid is narrower by design today: it is strongest for front-end React applications where export clarity, generation accounting, and an inspectable artifact matter more than an all-in-one managed backend."}],"$undefined"]}]]}]}]
