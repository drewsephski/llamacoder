{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/sentinel/layout,_N_T_/sentinel/page,_N_T_/sentinel"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/sentinel/__PAGE__",
    "/sentinel",
    "/_index",
    "/_head"
  ]
}