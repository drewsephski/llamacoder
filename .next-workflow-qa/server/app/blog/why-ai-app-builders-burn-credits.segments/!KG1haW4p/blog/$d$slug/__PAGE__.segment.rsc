c:T4ef,{"@context":"https://schema.org","@type":"FAQPage","@id":"https://www.squidagent.app/blog/why-ai-app-builders-burn-credits#faq","url":"https://www.squidagent.app/blog/why-ai-app-builders-burn-credits","mainEntity":[{"@type":"Question","name":"Why can a small edit use many tokens?","acceptedAnswer":{"@type":"Answer","text":"The model may need to reread a large project and produce enough context to preserve existing behavior. Input context can outweigh the visible size of the request."}},{"@type":"Question","name":"Should an AI builder charge for failed generations?","acceptedAnswer":{"@type":"Answer","text":"Policies vary, but buyers should demand a clear definition of success and an auditable recovery path for reserved usage when no durable result is saved."}},{"@type":"Question","name":"Are automated repairs always free in Squid?","acceptedAnswer":{"@type":"Answer","text":"Squid's current preview-repair path is marked as non-chargeable. User-requested follow-up edits are normal generations and can use credits."}},{"@type":"Question","name":"What is the best cost metric?","acceptedAnswer":{"@type":"Answer","text":"Total builder usage per accepted, saved, locally runnable result, with retries and manual interventions reported alongside it."}}]}7:["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$c"}}]
