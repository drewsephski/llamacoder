c:T472,{"@context":"https://schema.org","@type":"FAQPage","@id":"https://www.squidagent.app/blog/bolt-new-keeps-burning-tokens#faq","url":"https://www.squidagent.app/blog/bolt-new-keeps-burning-tokens","mainEntity":[{"@type":"Question","name":"Why does token burn increase on later edits?","acceptedAnswer":{"@type":"Answer","text":"Larger project context means the model processes more content each step. Narrow scope prompts reduce unnecessary context usage."}},{"@type":"Question","name":"Can token tools be compared to credit tools?","acceptedAnswer":{"@type":"Answer","text":"Only after normalizing to accepted checkpoints. Raw units are useful only with equivalent acceptance criteria."}},{"@type":"Question","name":"What is the practical stopping rule?","acceptedAnswer":{"@type":"Answer","text":"Stop when burn exceeds your per-checkpoint threshold and switch to a narrower, structured edit prompt."}},{"@type":"Question","name":"How do I prove burn control in a review deck?","acceptedAnswer":{"@type":"Answer","text":"Log token or credit burn per attempt, plus restore/diff outcome and local-build status for each accepted output."}}]}7:["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$c"}}]
