c:T61c,{"@context":"https://schema.org","@type":"FAQPage","@id":"https://www.squidagent.app/blog/how-to-evaluate-ai-generated-react-code#faq","url":"https://www.squidagent.app/blog/how-to-evaluate-ai-generated-react-code","mainEntity":[{"@type":"Question","name":"What should I check first in generated React code?","acceptedAnswer":{"@type":"Answer","text":"Start with the entry point and internal import graph. If files are missing or exports do not match imports, the rest of the review cannot be trusted."}},{"@type":"Question","name":"Is a successful preview enough?","acceptedAnswer":{"@type":"Answer","text":"No. A preview may include hidden platform files, cached dependencies, or runtime behavior that the exported project does not reproduce."}},{"@type":"Question","name":"Should generated code have zero accessibility warnings?","acceptedAnswer":{"@type":"Answer","text":"Treat automated warnings as a baseline. Passing mechanical checks still requires keyboard, screen-reader, contrast, focus, and interaction review."}},{"@type":"Question","name":"How do I test whether edits are safe?","acceptedAnswer":{"@type":"Answer","text":"Request one narrow change, diff every file, run the acceptance suite, and verify unrelated UI and behavior remain unchanged."}},{"@type":"Question","name":"What must an export include?","acceptedAnswer":{"@type":"Answer","text":"Source, package metadata, lockfile or package-manager guidance, build configuration, environment documentation, run instructions, and any framework support files the preview supplied implicitly."}}]}7:["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$c"}}]
