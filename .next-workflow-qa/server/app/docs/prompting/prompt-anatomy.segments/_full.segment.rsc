1f:["$","p",null,{"children":"“Build a dashboard” leaves both the data and decisions undefined. “Build a morning operations dashboard for a regional delivery manager” gives the interface a real point of view."}]
20:["$","p",null,{"children":"State the primary job as a verb: triage, schedule, compare, approve, publish, review, or track."}]
21:["$","h2",null,{"className":"scroll-mt-24","id":"2-list-essential-regions","children":"2. List essential regions"}]
22:["$","p",null,{"children":"Describe screens or regions by their purpose:"}]
23:["$","ul",null,{"children":["\n",["$","li",null,{"children":"A queue for work that needs attention."}],"\n",["$","li",null,{"children":"A detail view with enough context to make a decision."}],"\n",["$","li",null,{"children":"Filters that match how the audience thinks about the data."}],"\n",["$","li",null,{"children":"A success state that confirms what changed."}],"\n"]}]
24:["$","p",null,{"children":"This is more durable than micromanaging containers and grid columns."}]
25:["$","h2",null,{"className":"scroll-mt-24","id":"3-specify-interactions-and-states","children":"3. Specify interactions and states"}]
26:["$","p",null,{"children":"If a control must work, say what it changes. Include the non-happy states that make the surface feel complete."}]
27:["$","$L34",null,{"title":"Interaction requirements","text":"The status filter must update the visible jobs and result count. Selecting a row opens its detail panel without losing the current filters. Saving a reassignment should update the row, show a brief confirmation, and preserve the selected job. Include a useful no-results state and a disabled save state when nothing changed."}]
28:["$","h2",null,{"className":"scroll-mt-24","id":"4-give-visual-direction-with-evidence","children":"4. Give visual direction with evidence"}]
29:["$","p",null,{"children":"Use concrete qualities that affect implementation:"}]
2a:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Dense or spacious"}],"\n",["$","li",null,{"children":"Editorial or utilitarian"}],"\n",["$","li",null,{"children":"High-contrast or quiet"}],"\n",["$","li",null,{"children":"Sharp or rounded"}],"\n",["$","li",null,{"children":"Image-led or data-led"}],"\n",["$","li",null,{"children":"One accent color or a broader semantic palette"}],"\n"]}]
2b:["$","p",null,{"children":"If you provide a visual reference, explain which parts matter. A screenshot can guide layout and styling, but your text should still define the desired product behavior."}]
