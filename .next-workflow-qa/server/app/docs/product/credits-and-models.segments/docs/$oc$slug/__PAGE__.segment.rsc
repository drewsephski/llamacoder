3:["$","h2",null,{"className":"scroll-mt-24","id":"choose-for-the-task","children":"Choose for the task"}]
4:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Use a starter model for focused apps, contained edits, and early product exploration."}],"\n",["$","li",null,{"children":"Use a multimodal-capable model when screenshot interpretation is central to the task."}],"\n",["$","li",null,{"children":"Use a stronger coding or reasoning model for complex state, dense interfaces, or difficult repairs."}],"\n",["$","li",null,{"children":"Keep the prompt and acceptance criteria constant when comparing two models."}],"\n"]}]
5:["$","p",null,{"children":"Available models and their prices can change as providers evolve. Treat the model selector and its current estimate as the source of truth at the moment you generate."}]
6:["$","h2",null,{"className":"scroll-mt-24","id":"credit-visibility","children":"Credit visibility"}]
7:["$","p",null,{"children":"Squid’s generation flow separates the estimate shown before work from the usage recorded after a successful result is saved. The usage ledger helps you review project activity and credit changes over time."}]
8:["$","p",null,{"children":"If a request fails or a charge looks unexpected, preserve the project, model, time, and visible error details before contacting support."}]
9:["$","h2",null,{"className":"scroll-mt-24","id":"reduce-avoidable-retries","children":"Reduce avoidable retries"}]
a:["$","p",null,{"children":"Credits are best spent on clear, evaluable work:"}]
b:["$","ol",null,{"children":["\n",["$","li",null,{"children":"Start with one primary product job."}],"\n",["$","li",null,{"children":"Include important behavior and states in the first brief."}],"\n",["$","li",null,{"children":"Repair correctness before requesting visual polish."}],"\n",["$","li",null,{"children":"Make focused follow-ups instead of repeatedly regenerating the full app."}],"\n",["$","li",null,{"children":"Preserve working areas explicitly during edits."}],"\n"]}]
