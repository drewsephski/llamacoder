,{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","span",null,{"children":"Product"}]]}],["$","span","code-ownership",{"className":"flex items-center gap-1.5","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right size-3.5","aria-hidden":"true","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","span",null,{"className":"text-foreground","children":"Code Ownership"}]]}]]]}],["$","header",null,{"className":"mb-10 border-b border-border pb-8","children":[["$","h1",null,{"className":"text-balance text-4xl font-bold tracking-[-0.035em] sm:text-5xl","children":"Export & Own Your React Code"}],["$","p",null,{"className":"mt-4 max-w-2xl text-pretty text-lg leading-8 text-muted-foreground","children":"Export React files you own, track changes with checkpoints, restore earlier versions, and hand off production-ready code to any developer workflow."}]]}],null,["$","article",null,{"className":"docs-prose prose prose-zinc max-w-none dark:prose-invert prose-headings:font-semibold prose-headings:tracking-tight prose-h2:mt-14 prose-h2:border-t prose-h2:border-border prose-h2:pt-10 prose-h3:mt-9 prose-p:leading-7 prose-a:font-medium prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-strong:text-foreground prose-code:before:content-none prose-code:after:content-none prose-pre:my-7 prose-pre:overflow-x-auto prose-pre:rounded-xl prose-pre:border prose-pre:border-border prose-pre:bg-zinc-950 prose-pre:p-4 prose-pre:text-zinc-100 prose-li:my-1.5 prose-hr:border-border","children":[["$","p",null,{"children":"Squid Agent is an AI React app builder designed to produce code you can keep. Your generated app is available as inspectable source files, not locked inside a visual preview or a proprietary runtime. You can refine the project in Squid, export the accepted version, move it into your own repository, and continue development with the tools and team you choose."}],"\n","$L3","\n","$L4","\n","$L5","\n","$L6","\n","$L7","\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28"]}],"$L29"]}],"$L2a"]}],["$L2b"],"$L2c"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"q2m7bQIiF_hArhhzVxdCC"}
3:["$","p",null,{"children":"That portability is the practical foundation of code ownership: you can review what was generated, control which version becomes the handoff, and keep working after the project leaves Squid."}]
4:["$","h2",null,{"className":"scroll-mt-24","id":"what-code-ownership-means-in-squid-agent","children":"What code ownership means in Squid Agent"}]
5:["$","p",null,{"children":"An exportable React project gives you control over the source and the next development step. You can:"}]
6:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Inspect the generated components, routes, styles, configuration, and dependencies."}],"\n",["$","li",null,{"children":"Edit or refactor the files directly instead of requesting every change through an AI app builder."}],"\n",["$","li",null,{"children":"Download the project or publish an accepted bundle to your GitHub workflow."}],"\n",["$","li",null,{"children":"Run the app with a standard React, TypeScript, and Vite toolchain."}],"\n",["$","li",null,{"children":"Commit the source to your own repository, add tests and CI, and review future changes through normal pull requests."}],"\n",["$","li",null,{"children":"Choose your own hosting, analytics, authentication, database, and deployment process."}],"\n"]}]
7:["$","p",null,{"children":"The code can move without Squid. External services may still require their own accounts, credentials, migrations, pricing plans, or licenses, so portability should be evaluated across the complete application rather than the component source alone."}]
8:["$","h2",null,{"className":"scroll-mt-24","id":"what-is-included-in-an-exported-react-project","children":"What is included in an exported React project"}]
9:["$","p",null,{"children":"Squid assembles the selected generated files into a development-ready bundle. Depending on the app, the export includes:"}]
a:["$","ul",null,{"children":["\n",["$","li",null,{"children":"React and TypeScript source files for the accepted checkpoint"}],"\n",["$","li",null,{"children":"Required generated UI support files and inferred package dependencies"}],"\n",["$","li",null,{"children":"The application entry point, HTML shell, and project styles"}],"\n",["$","li",null,{"children":[["$","code",null,{"children":"package.json"}]," scripts for local development, type checking, and production builds"]}],"\n",["$","li",null,{"children":"TypeScript, Vite, Tailwind CSS, and PostCSS configuration"}],"\n",["$","li",null,{"children":"A README with local setup and detected integration guidance"}],"\n",["$","li",null,{"children":"An environment-variable template that keeps secret values out of source"}],"\n",["$","li",null,{"children":"A file manifest plus generated-code quality and export verification reports"}],"\n",["$","li",null,{"children":"Starter deployment configuration for Vercel, Netlify, and Cloudflare Workers"}],"\n"]}]
b:["$","p",null,{"children":["Exact contents vary with the generated app. Review the README, ",["$","code",null,{"children":"squid-manifest.json"}],", ",["$","code",null,{"children":"squid-quality-report.json"}],", and ",["$","code",null,{"children":"squid-verification-report.json"}]," in the exported bundle instead of assuming that every project has the same dependencies or integration requirements."]}]
c:["$","h2",null,{"className":"scroll-mt-24","id":"generated-files-are-the-source-of-the-current-version","children":"Generated files are the source of the current version"}]
d:["$","p",null,{"children":"The file view is the durable representation of the selected app checkpoint. The preview helps you evaluate appearance and behavior, but the generated files show what you will actually take into another development environment."}]
e:["$","p",null,{"children":"Before accepting a version, confirm that:"}]
f:["$","ul",null,{"children":["\n",["$","li",null,{"children":"The main entry point and expected feature components are present."}],"\n",["$","li",null,{"children":"Internal imports resolve to generated or included support files."}],"\n",["$","li",null,{"children":"Package and build configuration match the generated runtime."}],"\n",["$","li",null,{"children":"Important interactions are implemented in code rather than represented only by static markup."}],"\n",["$","li",null,{"children":"Placeholder data, copy, links, and assets are appropriate for the intended handoff."}],"\n"]}]
10:["$","p",null,{"children":["Use the ",["$","$L2",null,{"href":"/docs/product/quality-checks","children":"quality checks guide"}]," to understand which structural issues Squid can detect and which runtime, security, accessibility, and product checks still require human review."]}]
11:["$","h2",null,{"className":"scroll-mt-24","id":"how-checkpoints-protect-project-history","children":"How checkpoints protect project history"}]
12:["$","p",null,{"children":"Each code-bearing generation or accepted follow-up becomes a version checkpoint in the project history. This gives you a recoverable sequence of working states while you iterate on layout, behavior, content, and integrations."}]
13:["$","p",null,{"children":"From the version controls, you can inspect an earlier checkpoint, review its exact source changes, add a useful label or bookmark, and compare the files with the surrounding version. If a later edit introduces a regression, you can restore the complete earlier version or restore only selected files."}]
14:["$","p",null,{"children":"A restore does not erase or rewrite the historical record. Squid creates a new current checkpoint from the restored source while retaining the versions that came before it. Selective restore follows the same principle: the chosen older files are combined with the unaffected files from the current version, then saved as another checkpoint."}]
15:["$","p",null,{"children":"This makes experiments safer, but checkpoints are not a replacement for Git. Squid history protects the generation and refinement phase. After export, create a repository commit for the untouched accepted bundle so downstream changes have their own reviewable baseline."}]
16:["$","h2",null,{"className":"scroll-mt-24","id":"move-generated-react-code-into-your-workflow","children":"Move generated React code into your workflow"}]
17:["$","p",null,{"children":"Use a deliberate handoff sequence instead of treating export as a one-click production approval:"}]
18:["$","ol",null,{"children":["\n",["$","li",null,{"children":"Select the checkpoint that passed your product and visual acceptance criteria."}],"\n",["$","li",null,{"children":"Review its source diff, file tree, quality report, and any unresolved integration setup."}],"\n",["$","li",null,{"children":"Verify and download the ZIP, or publish the accepted bundle into an authorized GitHub repository."}],"\n",["$","li",null,{"children":"Open the project in a clean directory and follow the included README."}],"\n",["$","li",null,{"children":["Run ",["$","code",null,{"children":"pnpm install"}],", ",["$","code",null,{"children":"pnpm typecheck"}],", and ",["$","code",null,{"children":"pnpm build"}],", then test the primary workflow in the local app."]}],"\n",["$","li",null,{"children":"Commit the untouched export as a baseline before adapting architecture, adding services, or merging it into a larger codebase."}],"\n"]}]
19:["$","p",null,{"children":["Testing in a clean directory matters. Existing monorepo dependencies, cached packages, global tools, and local environment variables can make an incomplete project appear healthy. The ",["$","$L2",null,{"href":"/docs/workflows/export-and-handoff","children":"export and handoff guide"}]," provides a practical validation and delivery checklist."]}]
1a:["$","aside",null,{"className":"not-prose my-7 grid grid-cols-[auto_1fr] gap-3 rounded-xl border p-4 text-sm leading-6 border-primary/25 bg-primary/[0.07]","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-sparkles mt-0.5 size-5 text-primary","aria-hidden":"true","children":[["$","path","1s2grr",{"d":"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"}],["$","path","1rf3ol",{"d":"M20 2v4"}],["$","path","gwowj6",{"d":"M22 4h-4"}],["$","circle","6kqj1y",{"cx":"4","cy":"20","r":"2"}],"$undefined"]}],["$","div",null,{"children":[["$","p",null,{"className":"mb-1 font-semibold text-foreground","children":"Ownership still includes responsibility"}],["$","div",null,{"className":"text-muted-foreground [&_a]:font-medium [&_a]:text-primary [&_p+p]:mt-2","children":["$","p",null,{"children":"Exportable source gives you control over the project, but it is not automatic\nproduction approval. Review generated code, third-party licenses, copied\ncontent and assets, data handling, accessibility, security, environment\nvariables, and external-service configuration before release."}]}]]}]]}]
1b:["$","h2",null,{"className":"scroll-mt-24","id":"prepare-a-developer-handoff","children":"Prepare a developer handoff"}]
1c:["$","p",null,{"children":"A useful handoff includes more than a ZIP file. Give the next developer the accepted checkpoint, the original product brief, important follow-up prompts, and a short description of the primary user path. Include desktop and mobile acceptance screenshots, known limitations, unresolved quality warnings, and the names of required environment variables without including secret values."}]
1d:["$","p",null,{"children":"Also explain which integrations are live, mocked, or still awaiting configuration. If the destination project uses different routing, state management, styling, or deployment conventions, preserve the verified export as a baseline and adapt it through explicit, reviewable commits."}]
1e:["$","h2",null,{"className":"scroll-mt-24","id":"code-ownership-questions","children":"Code ownership questions"}]
1f:["$","h3",null,{"className":"scroll-mt-24","id":"can-i-use-the-generated-react-code-outside-squid-agent","children":"Can I use the generated React code outside Squid Agent?"}]
20:["$","p",null,{"children":"Yes. The export is assembled as a conventional React, TypeScript, and Vite project with source, package scripts, build configuration, and setup guidance. You can continue locally, move it into an existing repository, or deploy it through your preferred platform."}]
21:["$","h3",null,{"className":"scroll-mt-24","id":"can-another-developer-take-over-the-project","children":"Can another developer take over the project?"}]
22:["$","p",null,{"children":"Yes. The source files are inspectable and editable, and the export includes the configuration and evidence needed to begin a normal engineering handoff. A developer should still install and build the project in a clean environment, review its architecture, and validate every production requirement."}]
23:["$","h3",null,{"className":"scroll-mt-24","id":"are-checkpoints-the-same-as-git-commits","children":"Are checkpoints the same as Git commits?"}]
24:["$","p",null,{"children":"No. Squid checkpoints preserve generated versions and make full or file-level restoration possible during AI-assisted iteration. Git should become the source of truth for branching, code review, CI, releases, and long-term maintenance after the export enters your engineering workflow."}]
25:["$","h3",null,{"className":"scroll-mt-24","id":"does-an-export-guarantee-production-ready-code","children":"Does an export guarantee production-ready code?"}]
26:["$","p",null,{"children":"No automated export can guarantee that an application meets every business, security, privacy, accessibility, or operational requirement. Squid includes structural diagnostics and export verification evidence so you can identify known issues, but production acceptance remains a team decision backed by local builds, interaction tests, and deployment review."}]
27:["$","h2",null,{"className":"scroll-mt-24","id":"a-handoff-focused-follow-up","children":"A handoff-focused follow-up"}]
28:["$","$L2d",null,{"title":"Prepare for handoff","text":"Prepare this project for a developer handoff without changing the approved interface.\n\nPreserve all working screens, interactions, copy, sample data, routes, and visual tokens. Improve file naming and component boundaries only where they are currently confusing, remove dead code, and make required setup assumptions explicit in the project README.\n\nDo not add features, dependencies, services, or a new design system."}]
