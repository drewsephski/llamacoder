6:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Changing a segment changes all visible analytics, not only the table."}],"\n",["$","li",null,{"children":"The table remains the primary information surface."}],"\n",["$","li",null,{"children":"Health colors are backed by text labels or icons."}],"\n",["$","li",null,{"children":"The detail drawer explains the score rather than repeating it."}],"\n",["$","li",null,{"children":"Empty and no-results states tell the user how to recover."}],"\n",["$","li",null,{"children":"The mobile version prioritizes the account list and essential filters."}],"\n"]}]
