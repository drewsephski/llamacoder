4:["$","$L14",null,{"title":"Follow-up template","text":"Change [specific surface or behavior].\n\nPreserve [working layout, data, components, routes, or visual tokens that must not change].\n\nThe result must [observable acceptance criteria, including responsive or accessibility behavior].\n\nDo not [likely scope expansion or unrelated redesign]."}]
5:["$","h2",null,{"className":"scroll-mt-24","id":"repair-correctness-before-polish","children":"Repair correctness before polish"}]
6:["$","p",null,{"children":"When something is broken, include reproduction details:"}]
7:["$","$L14",null,{"title":"Behavior repair","text":"Fix the status filter on the projects table.\n\nCurrently, choosing Archived changes the selected control but leaves every row visible. Preserve the table columns, records, sorting, pagination, and visual design.\n\nThe selected status must filter the rows and result count, show the existing no-results state when appropriate, and remain selected after opening and closing a project. Do not redesign the table."}]
8:["$","h2",null,{"className":"scroll-mt-24","id":"separate-content-and-design-edits","children":"Separate content and design edits"}]
9:["$","p",null,{"children":"Combining new sample data, a visual redesign, a navigation change, and a behavior fix makes it difficult to identify what caused a regression. Make each concern a separate checkpoint when practical."}]
a:["$","p",null,{"children":"Useful edit boundaries include:"}]
b:["$","ul",null,{"children":["\n",["$","li",null,{"children":"One screen or component"}],"\n",["$","li",null,{"children":"One interaction path"}],"\n",["$","li",null,{"children":"Mobile behavior only"}],"\n",["$","li",null,{"children":"Copy and data only"}],"\n",["$","li",null,{"children":"Color and typography only"}],"\n",["$","li",null,{"children":"Accessibility behavior only"}],"\n"]}]
c:["$","h2",null,{"className":"scroll-mt-24","id":"review-the-diff-in-the-product","children":"Review the diff in the product"}]
d:["$","p",null,{"children":"After each edit:"}]
e:["$","ol",null,{"children":["\n",["$","li",null,{"children":"Re-run the interaction you changed."}],"\n",["$","li",null,{"children":"Check the surfaces you explicitly protected."}],"\n",["$","li",null,{"children":"Compare desktop and mobile if the layout changed."}],"\n",["$","li",null,{"children":"Inspect the generated files for accidental scope expansion."}],"\n",["$","li",null,{"children":"Restore an earlier checkpoint if the edit moved the project backward."}],"\n"]}]
