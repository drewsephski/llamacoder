3:["$","h2",null,{"className":"scroll-mt-24","id":"prepare-the-reference","children":"Prepare the reference"}]
4:["$","p",null,{"children":"Use a clear PNG, JPEG, or WebP image. Crop unrelated browser chrome if it is not part of the target interface, and avoid uploading secrets, private customer data, or credentials."}]
5:["$","p",null,{"children":"For a website reference, identify the exact page and state you care about. A public homepage and a signed-in product screen imply very different structures."}]
6:["$","h2",null,{"className":"scroll-mt-24","id":"describe-what-to-preserve","children":"Describe what to preserve"}]
7:["$","$L15",null,{"title":"Reference instructions","text":"Use the attached screenshot as the source of truth for the layout hierarchy, spacing density, typography relationships, surface colors, border treatment, and selected states.\n\nDo not copy the original brand, personal information, or static screenshot pixels into the app. Recreate the interface with semantic React components and make all specified controls functional."}]
8:["$","p",null,{"children":"Then add the product behavior: what the user selects, edits, submits, and sees afterward."}]
9:["$","h2",null,{"className":"scroll-mt-24","id":"verify-in-two-passes","children":"Verify in two passes"}]
a:["$","p",null,{"children":"First, compare the visual system:"}]
b:["$","ul",null,{"children":["\n",["$","li",null,{"children":"First-viewport composition"}],"\n",["$","li",null,{"children":"Region widths and alignment"}],"\n",["$","li",null,{"children":"Typography scale and line breaks"}],"\n",["$","li",null,{"children":"Color and border contrast"}],"\n",["$","li",null,{"children":"Density, spacing, and container model"}],"\n"]}]
c:["$","p",null,{"children":"Then test product behavior:"}]
d:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Controls change the correct state."}],"\n",["$","li",null,{"children":"Selected values remain visible."}],"\n",["$","li",null,{"children":"Errors and empty states are recoverable."}],"\n",["$","li",null,{"children":"Mobile behavior preserves the primary task."}],"\n",["$","li",null,{"children":"Focus order and labels remain understandable without the screenshot."}],"\n"]}]
