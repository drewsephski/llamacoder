21:["$","h2",null,{"className":"scroll-mt-24","id":"what-to-leave-out","children":"What to leave out"}]
22:["$","p",null,{"children":"You rarely need to prescribe every component name, folder, CSS class, or dependency. Over-specifying implementation can force unrelated decisions before the product structure is clear."}]
23:["$","p",null,{"children":"Instead of “use seven cards in a three-column grid,” say what the user must compare and which item deserves the most emphasis. Instead of “add animations everywhere,” describe the moment where motion should clarify a state change."}]
24:["$","h2",null,{"className":"scroll-mt-24","id":"keep-follow-ups-testable","children":"Keep follow-ups testable"}]
25:["$","p",null,{"children":"Use follow-up prompts to isolate one kind of change:"}]
26:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Behavior:"}]," “Keep the layout unchanged; make filters update the results and empty state.”"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Content:"}]," “Keep the structure; replace generic sample data with realistic field-service jobs.”"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Visual system:"}]," “Keep the workflow; reduce border density and strengthen type hierarchy.”"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Responsive:"}]," “Keep desktop unchanged; make the detail panel usable below 768px.”"]}],"\n"]}]
27:["$","p",null,{"children":"That makes each new checkpoint easier to compare with the previous one."}]
