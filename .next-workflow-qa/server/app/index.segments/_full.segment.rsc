5e:["$","p",null,{"className":"mt-3 text-sm leading-6 text-muted-foreground","children":"Start with a prototype and connect services when the core experience is working. Public browser-safe APIs can work directly; databases, secrets, and privileged services stay behind an explicit setup boundary and are never presented as complete before they are connected."}]
5f:["$","details","Can Squid Agent publish or export my app?",{"className":"group rounded-[22px] border border-border/70 bg-background/80 p-5 shadow-[0_16px_42px_-34px_rgba(0,0,0,0.55)] backdrop-blur","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-lg font-semibold leading-snug tracking-normal text-foreground","children":"Can Squid Agent publish or export my app?"}],["$","span",null,{"className":"mt-1 shrink-0 text-lg text-muted-foreground transition-transform group-open:rotate-45","aria-hidden":"true","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-muted-foreground","children":"Yes. Publish verified code to a GitHub repository, deploy a Vercel preview or production build, share and remix a public project, or download a verified project bundle with React source, configuration, setup instructions, and quality reports. Your code remains portable outside Squid Agent."}]]}]
60:["$","details","How does Squid Agent handle AI credits?",{"className":"group rounded-[22px] border border-border/70 bg-background/80 p-5 shadow-[0_16px_42px_-34px_rgba(0,0,0,0.55)] backdrop-blur","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-lg font-semibold leading-snug tracking-normal text-foreground","children":"How does Squid Agent handle AI credits?"}],["$","span",null,{"className":"mt-1 shrink-0 text-lg text-muted-foreground transition-transform group-open:rotate-45","aria-hidden":"true","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-muted-foreground","children":"Squid Agent shows the model and expected credit range before generation, then records the actual charge after successful work is saved. Failed initial generations are not charged, preview repairs are free, and receipts make charges and refunds visible."}]]}]
