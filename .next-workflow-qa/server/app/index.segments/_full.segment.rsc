57:["$","details","Can Squid audit an app made with another AI builder?",{"className":"group rounded-[22px] border border-border/70 bg-background/80 p-5 shadow-[0_16px_42px_-34px_rgba(0,0,0,0.55)] backdrop-blur","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-lg font-semibold leading-snug tracking-normal text-foreground","children":"Can Squid audit an app made with another AI builder?"}],["$","span",null,{"className":"mt-1 shrink-0 text-lg text-muted-foreground transition-transform group-open:rotate-45","aria-hidden":"true","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-muted-foreground","children":"Yes. The free source audit accepts a public GitHub repository or exported ZIP and checks project structure, reproducible build signals, environment documentation, recognized platform coupling, and obvious client-side credential assignments. It is a static inspection and does not claim to prove production behavior."}]]}]
58:["$","details","Who is Squid Agent for?",{"className":"group rounded-[22px] border border-border/70 bg-background/80 p-5 shadow-[0_16px_42px_-34px_rgba(0,0,0,0.55)] backdrop-blur","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-lg font-semibold leading-snug tracking-normal text-foreground","children":"Who is Squid Agent for?"}],["$","span",null,{"className":"mt-1 shrink-0 text-lg text-muted-foreground transition-transform group-open:rotate-45","aria-hidden":"true","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-muted-foreground","children":"Squid Agent is built for founders, designers, builders, and product teams who want to test product ideas quickly without throwing away the generated React code."}]]}]
59:["$","details","Can Squid Agent research current documentation and APIs?",{"className":"group rounded-[22px] border border-border/70 bg-background/80 p-5 shadow-[0_16px_42px_-34px_rgba(0,0,0,0.55)] backdrop-blur","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-lg font-semibold leading-snug tracking-normal text-foreground","children":"Can Squid Agent research current documentation and APIs?"}],["$","span",null,{"className":"mt-1 shrink-0 text-lg text-muted-foreground transition-transform group-open:rotate-45","aria-hidden":"true","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-muted-foreground","children":"Yes. Squid Agent can search the live web for current documentation, API references, package guidance, recommendations, and time-sensitive facts. You can see when research is happening and inspect the supporting sources instead of relying on hidden or stale model knowledge."}]]}]
5a:["$","details","What does Plan mode do?",{"className":"group rounded-[22px] border border-border/70 bg-background/80 p-5 shadow-[0_16px_42px_-34px_rgba(0,0,0,0.55)] backdrop-blur","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-lg font-semibold leading-snug tracking-normal text-foreground","children":"What does Plan mode do?"}],["$","span",null,{"className":"mt-1 shrink-0 text-lg text-muted-foreground transition-transform group-open:rotate-45","aria-hidden":"true","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-muted-foreground","children":"Plan mode is optional. Turn it on when the idea is still ambiguous and you want Squid to ask consequential questions before generating. Leave it off to move directly into a prototype."}]]}]
5b:["$","div","1",{"className":"grid content-start gap-4","children":[["$","details","Can I keep editing after the first generation?",{"className":"group rounded-[22px] border border-border/70 bg-background/80 p-5 shadow-[0_16px_42px_-34px_rgba(0,0,0,0.55)] backdrop-blur","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-lg font-semibold leading-snug tracking-normal text-foreground","children":"Can I keep editing after the first generation?"}],["$","span",null,{"className":"mt-1 shrink-0 text-lg text-muted-foreground transition-transform group-open:rotate-45","aria-hidden":"true","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-muted-foreground","children":"Yes. Continue in chat to make source-aware changes, or select an element in the live preview and describe the exact edit. Squid Agent works from the current project files so a focused change does not have to replace the entire application."}]]}],["$","details","How does Squid Agent verify and repair a build?",{"className":"group rounded-[22px] border border-border/70 bg-background/80 p-5 shadow-[0_16px_42px_-34px_rgba(0,0,0,0.55)] backdrop-blur","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-lg font-semibold leading-snug tracking-normal text-foreground","children":"How does Squid Agent verify and repair a build?"}],["$","span",null,{"className":"mt-1 shrink-0 text-lg text-muted-foreground transition-transform group-open:rotate-45","aria-hidden":"true","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-muted-foreground","children":"Squid Agent checks files, imports, exports, dependencies, accessibility basics, API safety, and the running preview. It shows what passed, what still needs review, and what was not tested. Recoverable preview problems can be repaired automatically without charging for the repair run."}]]}],["$","details","Can I restore an earlier version without losing newer work?",{"className":"group rounded-[22px] border border-border/70 bg-background/80 p-5 shadow-[0_16px_42px_-34px_rgba(0,0,0,0.55)] backdrop-blur","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-lg font-semibold leading-snug tracking-normal text-foreground","children":"Can I restore an earlier version without losing newer work?"}],["$","span",null,{"className":"mt-1 shrink-0 text-lg text-muted-foreground transition-transform group-open:rotate-45","aria-hidden":"true","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-muted-foreground","children":"Yes. Code-bearing responses become visible checkpoints with summaries and exact diffs. Restore a complete version or recover selected files only, so you can undo one direction without overwriting unrelated work you want to keep."}]]}],["$","details","How do APIs and connected services work?",{"className":"group rounded-[22px] border border-border/70 bg-background/80 p-5 shadow-[0_16px_42px_-34px_rgba(0,0,0,0.55)] backdrop-blur","children":["$L5d","$L5e"]}],"$L5f","$L60","$L61"]}]
