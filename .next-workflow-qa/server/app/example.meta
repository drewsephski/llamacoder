{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/example/layout,_N_T_/example/page,_N_T_/example"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/example/__PAGE__",
    "/example",
    "/_index",
    "/_head"
  ]
}